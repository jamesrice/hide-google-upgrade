{
  "manifest_version": 3,
  "name": "Hide Google Upgrade Buttons",
  "version": "1.0.0",
  "description": "Hides the promotional \"Upgrade\" buttons in Google Workspace web apps. Runs entirely locally: no permissions, no background page, no network access.",
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://chat.google.com/*",
        "https://docs.google.com/*",
        "https://drive.google.com/*",
        "https://calendar.google.com/*",
        "https://meet.google.com/*",
        "https://keep.google.com/*",
        "https://tasks.google.com/*",
        "https://contacts.google.com/*",
        "https://groups.google.com/*",
        "https://sites.google.com/*"
      ],
      "css": ["hide-upgrade.css"],
      "js": ["hide-upgrade.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
